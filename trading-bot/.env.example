# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# 1) Bot bei @BotFather in Telegram erstellen -> Token hier eintragen
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2) Deine Chat-ID (schreibe @userinfobot in Telegram an, er zeigt sie dir)
TELEGRAM_CHAT_ID=123456789

# Optional: Kerzen-Intervall (5m, 15m, 30m, 1h) — Standard 15m
CANDLE_INTERVAL=15m

# Optional: Wie oft geprüft wird (Sekunden) — Standard 300 (5 Min.)
CHECK_EVERY_SECONDS=300

# Optional: Mindestabstand zwischen zwei Alarmen pro Markt (Sekunden)
COOLDOWN_SECONDS=3600
